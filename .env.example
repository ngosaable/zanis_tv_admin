APP_NAME=zanis_tv
APP_ENV=local
APP_KEY=base64:ww4edsEnn6xNKcqH7yYCBpiH7ycJOiMC7OZXHa51K5E=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (XAMPP MySQL/MariaDB defaults: user root, empty password) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zanis_tv
DB_USERNAME=root
DB_PASSWORD=

# --- First admin account (created by: php artisan db:seed) ---
ADMIN_NAME="Zanis Admin"
ADMIN_EMAIL=admin@zanistv.com
ADMIN_PASSWORD=ChangeMe123!

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
# "database" = video conversion runs in the background via: php artisan queue:work
# (use "sync" only for tiny test files - it converts inside the upload request)
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- FFmpeg (needed to convert uploads to HLS streams) ---
# Leave as-is if ffmpeg is on your PATH, otherwise use full paths (no spaces), e.g.
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe

FFMPEG_BINARY=/usr/local/bin/ffmpeg
FFPROBE_BINARY=/usr/local/bin/ffprobe

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails (password resets) are written to storage/logs/laravel.log locally
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@zanistv.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
